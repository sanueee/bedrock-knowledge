                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie10" value="следующий&lt;br&gt;спящий поток" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ip5" target="id1" edge="1">

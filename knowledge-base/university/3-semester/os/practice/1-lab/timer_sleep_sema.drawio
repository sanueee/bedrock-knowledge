                    </mxGeometry>
                </mxCell>
                <mxCell id="ie8" value="Нет&lt;br&gt;(срок наступил)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;labelBackgroundColor=#ffffff;" parent="1" source="id2" target="ip4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>

                <mxCell id="p1" value="Создать описатель&lt;br&gt;&lt;b&gt;struct sleeper s&lt;/b&gt; в стеке потока;&lt;br&gt;sema_init(&amp;amp;s.sema, &lt;b&gt;0&lt;/b&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">

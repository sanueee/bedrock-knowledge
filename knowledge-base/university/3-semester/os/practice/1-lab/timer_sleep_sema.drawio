                <mxCell id="p4" value="list_insert_ordered(&amp;amp;sleep_list,&lt;br&gt;&amp;amp;s.elem, sleeper_less)&lt;br&gt;&lt;i&gt;вставка по возрастанию deadline&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
